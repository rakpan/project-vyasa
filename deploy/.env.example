# Project Vyasa - Environment Template
# Copy this file to deploy/.env and fill in real values.

# -----------------------------
# Service Images
# -----------------------------
CORTEX_IMAGE=nvcr.io/nvidia/sglang:latest
DRAFTER_IMAGE=ollama/ollama:latest
MEMORY_IMAGE=arangodb:latest
VECTOR_IMAGE=qdrant/qdrant:latest
ORCHESTRATOR_IMAGE=vyasa-orchestrator:latest

# -----------------------------
# Ports (host:container)
# -----------------------------
PORT_BRAIN=30000
PORT_WORKER=30001
PORT_VISION=30002
PORT_DRAFTER=11434
PORT_CONSOLE=3000
PORT_MEMORY=8529
PORT_VECTOR=6333
PORT_EMBEDDER=8000

# -----------------------------
# Model Configuration (Canonical Variables)
# -----------------------------
# Use TEXT_MODEL_ID, VISION_MODEL_ID, EMBEDDER_MODEL_ID for all model configuration.
# Legacy vars (BRAIN_MODEL_PATH, WORKER_MODEL_PATH, etc.) are supported for one release with deprecation warnings.

# Text model (used by both Brain and Worker services)
TEXT_MODEL_ID=meta-llama/Llama-3.3-70B-Instruct

# Vision model (used by Vision service)
VISION_MODEL_ID=Qwen/Qwen2-VL-7B-Instruct

# Embedder model (used by Embedder service)
EMBEDDER_MODEL_ID=nvidia/nv-embedqa-e5-v5
EMBEDDING_DIMENSION=1024

# Legacy variables (deprecated - use canonical vars above)
# BRAIN_MODEL_PATH=meta-llama/Llama-3.1-8B-Instruct  # Deprecated: use TEXT_MODEL_ID
# WORKER_MODEL_PATH=nvidia/Llama-3_3-Nemotron-Super-49B-v1_5  # Deprecated: use TEXT_MODEL_ID
# VISION_MODEL_PATH=Qwen/Qwen2-VL-72B-Instruct  # Deprecated: use VISION_MODEL_ID
# EMBEDDING_MODEL_PATH=BAAI/bge-large-en-v1.5  # Deprecated: use EMBEDDER_MODEL_ID
HF_TOKEN=changeme   # Required if pulling gated models

# -----------------------------
# GPU Binding (use comma-separated IDs, or leave empty for CPU-only where supported)
# -----------------------------
BRAIN_GPU_IDS=0
WORKER_GPU_IDS=1
VISION_GPU_IDS=2
DRAFTER_GPU_IDS=3

# -----------------------------
# Network / Containers
# -----------------------------
NETWORK_NAME=vyasa-net
CONTAINER_CONSOLE=vyasa-console
CONTAINER_GRAPH=vyasa-graph
CONTAINER_QDRANT=vyasa-vector
CONTAINER_EMBEDDER=vyasa-embedder
CONTAINER_ORCHESTRATOR=vyasa-orchestrator

# -----------------------------
# Database / Auth
# -----------------------------
GRAPH_DB_NAME=project_vyasa
ARANGODB_USER=root
ARANGODB_PASSWORD=
ARANGO_ROOT_PASSWORD=
QDRANT_API_KEY=
CONSOLE_PASSWORD=changeme
CONSOLE_SECRET=changeme
NEXTAUTH_SECRET=changeme

# -----------------------------
# Vector / Embedder
# -----------------------------
EMBEDDER_MODEL_NAME=BAAI/bge-large-en-v1.5

# -----------------------------
# Vision Controls
# -----------------------------
VISION_MAX_IMAGES=5

# -----------------------------
# Orchestrator
# -----------------------------
ORCHESTRATOR_URL=http://orchestrator:8000

# -----------------------------
# Web Augmentation (Optional) - Firecrawl Cloud
# -----------------------------
# Vyasa uses Firecrawl Cloud for retrieval; Vyasa owns extraction and governance.
# Free tier limited to 500/month; use only for high-fidelity disputes.
WEB_AUGMENTATION_ENABLED=false
WORKBENCH_WEB_SEARCH_ENABLED=false

# Firecrawl Cloud Configuration
FIRECRAWL_MODE=cloud
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev
FIRECRAWL_MONTHLY_QUOTA=500
FIRECRAWL_FAIL_OPEN=false

# Google Custom Search (for workbench web search)
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
WEB_MAX_SEARCH_RESULTS=10

# Domain Policy (PSE configuration is authoritative; these are safety guardrails)
WEB_DOMAIN_ALLOWLIST=.edu,.gov,.org,.com,.net
WEB_DOMAIN_BLOCKLIST=twitter.com,x.com,facebook.com,instagram.com,linkedin.com,reddit.com

# Web Augmentation Limits
WEB_MAX_URLS_PER_REQUEST=5
WEB_MAX_URLS=10
WEB_MAX_PAGES=25
WEB_TIMEOUT_SECONDS=30
WEB_CRAWL_ENABLED=false

# Deprecated: Local Firecrawl deployment removed due to instability
# FIRECRAWL_IMAGE=firecrawl:local
# FIRECRAWL_PORT=3002
# FIRECRAWL_SERVICE_URL=http://firecrawl:3002
